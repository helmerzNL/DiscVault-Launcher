TZ=Europe/Amsterdam
DISCVAULT_IMAGE=ghcr.io/helmerznl/discvault:beta
DISCVAULT_DATA_DIR=./data
DISCVAULT_WEB_PORT=6180

POSTGRES_DB=discvault_next
POSTGRES_USER=discvault_next
POSTGRES_PASSWORD=change-me-to-a-long-random-password

JWT_SECRET=change-me-to-a-long-random-session-secret
# Optional separate stable key for MovieVault credentials encrypted in
# PostgreSQL. Leave empty to derive them from JWT_SECRET. Setting this on an
# existing install makes previously stored credentials unreadable, so only set
# it before first use or re-enter the credentials afterwards.
DISCVAULT_NEXT_KEY_ENCRYPTION_KEY=
RP_ID=localhost
RP_NAME=DiscVault
RP_ORIGINS=http://localhost:6180

# Opt-in capability gate for password + TOTP authentication. Passkeys remain
# the recommended method.
LEGACY_AUTH_ENABLED=false

# Which channel the in-app update check should follow: auto, beta or stable.
# The launcher derives this from the deployed image tag; set it here only when
# running this compose file directly.
DISCVAULT_UPDATE_CHANNEL=auto

# Destructive admin dedup execution stays disabled until its matching/report
# workflow has been reviewed for the deployed release.
DISCVAULT_ADMIN_DEDUP_EXECUTE_ENABLED=false

DISCVAULT_NEXT_API_WORKERS=2
DISCVAULT_NEXT_API_TIMEOUT=180
DISCVAULT_WORKER_ID=next-worker-1
DISCVAULT_WORKER_POLL_INTERVAL=2
DISCVAULT_NEXT_ENABLE_TEST_RESET=false